{
  "name": "infinite-canvas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "check:types": "tsc --noEmit -p tsconfig.app.json",
    "check:biome": "biome lint --diagnostic-level=error --no-errors-on-unmatched --files-ignore-unknown=true",
    "check": "npm run check:types && npm run check:biome",
    "lint": "npm run check:biome",
    "format": "biome check --write --unsafe",
    "preview": "vite preview --host",
    "preview:dist": "npm run build && vite preview --host --port 4173",
    "build:ftp": "npm run build",
    "pack:ftp": "npm run build && rm -f infinite-canvas-ftp.zip && cd dist && zip -r ../infinite-canvas-ftp.zip .",
    "build:local": "tsc -b && vite build --config vite.config.offline.ts",
    "pack:local": "npm run build:local && rm -f infinite-canvas-local.zip && cd dist-local && zip -r ../infinite-canvas-local.zip .",
    "open:local": "npm run build:local && node scripts/serve-local.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.3",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.4.2",
    "@vercel/functions": "3.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.511.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "7.9.5",
    "tailwind-merge": "3.3.1",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "10.4.20",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "~5.9.3",
    "vite": "6.3.5"
  }
}
